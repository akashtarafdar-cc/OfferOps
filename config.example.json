{
  "defaults": {
    "cloudflare_plan": "free",
    "cloudflare_bot_fight_mode": true,
    "dns_ttl": 1,
    "ftp_quota_mb": 1024,
    "support_mail_quota_mb": 1024,
    "document_root_template": "public_html",
    "robots_txt": "User-Agent: *\nDisallow: /\nUser-agent: Googlebot-Image\nDisallow: /*.gif$\n\nUser-agent: Googlebot-Image\nDisallow: /*.jpg$\n\nUser-agent: Googlebot-Image\nDisallow: /*.jpeg$\n\nUser-agent: Googlebot-Image\nDisallow: /*.png$\n\nUser-agent: Googlebot-Image\nDisallow: /*.bmp$\n",
    "info_php": "<?php phpinfo();\n",
    "cron": {
      "minute_min": 15,
      "minute_max": 25,
      "hour": "*",
      "day": "*",
      "month": "*",
      "weekday": "*",
      "command_template": "php -q /home/{cpanel_username}/public_html/{offer_path}/library/cron.php >/dev/null 2>&1"
    }
  },
  "profiles": {
    "ecom-live": {
      "kind": "ecom",
      "cloudflare_account": "ecom",
      "whm_account": "ecom_live",
      "servers": ["live"],
      "server_ip_env": "WHM_ECOM_LIVE_SERVER_IP",
      "dns_records": [
        { "type": "A", "name": "@", "content": "{server_ip}", "proxied": true },
        { "type": "A", "name": "mail", "content": "{server_ip}", "proxied": false },
        { "type": "A", "name": "webmail", "content": "{server_ip}", "proxied": false },
        { "type": "A", "name": "www", "content": "{server_ip}", "proxied": true },
        { "type": "MX", "name": "@", "content": "mail.{domain}", "priority": 10 }
      ]
    },
    "ecom-bkp": {
      "kind": "ecom",
      "cloudflare_account": "ecom",
      "whm_account": "ecom_bkp",
      "servers": ["bkp"],
      "server_ip_env": "WHM_ECOM_BKP_SERVER_IP",
      "dns_records": [
        { "type": "A", "name": "@", "content": "{server_ip}", "proxied": true },
        { "type": "A", "name": "mail", "content": "{server_ip}", "proxied": false },
        { "type": "A", "name": "webmail", "content": "{server_ip}", "proxied": false },
        { "type": "A", "name": "www", "content": "{server_ip}", "proxied": true },
        { "type": "MX", "name": "@", "content": "mail.{domain}", "priority": 10 }
      ]
    },
    "sweeps-live": {
      "kind": "sweeps",
      "cloudflare_account": "sweeps",
      "whm_account": "sweeps_live",
      "servers": ["live"],
      "server_ip_env": "WHM_SWEEPS_LIVE_SERVER_IP",
      "dns_records": [
        { "type": "A", "name": "@", "content": "{server_ip}", "proxied": true },
        { "type": "A", "name": "mail", "content": "{server_ip}", "proxied": false },
        { "type": "A", "name": "webmail", "content": "{server_ip}", "proxied": false },
        { "type": "A", "name": "www", "content": "{server_ip}", "proxied": true },
        { "type": "MX", "name": "@", "content": "mail.{domain}", "priority": 10 }
      ]
    },
    "sweeps-live-2": {
      "kind": "sweeps",
      "cloudflare_account": "sweeps",
      "whm_account": "sweeps_live_2",
      "servers": ["live", "live-2"],
      "server_ip_env": "WHM_SWEEPS_LIVE_2_SERVER_IP",
      "dns_records": [
        { "type": "A", "name": "@", "content": "{server_ip}", "proxied": true },
        { "type": "A", "name": "mail", "content": "{server_ip}", "proxied": false },
        { "type": "A", "name": "webmail", "content": "{server_ip}", "proxied": false },
        { "type": "A", "name": "www", "content": "{server_ip}", "proxied": true },
        { "type": "MX", "name": "@", "content": "mail.{domain}", "priority": 10 }
      ]
    },
    "sweeps-bkp": {
      "kind": "sweeps",
      "cloudflare_account": "sweeps",
      "whm_account": "sweeps_bkp",
      "servers": ["bkp"],
      "server_ip_env": "WHM_SWEEPS_BKP_SERVER_IP",
      "dns_records": [
        { "type": "A", "name": "@", "content": "{server_ip}", "proxied": true },
        { "type": "A", "name": "mail", "content": "{server_ip}", "proxied": false },
        { "type": "A", "name": "webmail", "content": "{server_ip}", "proxied": false },
        { "type": "A", "name": "www", "content": "{server_ip}", "proxied": true },
        { "type": "MX", "name": "@", "content": "mail.{domain}", "priority": 10 }
      ]
    },
    "sweeps-bkp-2": {
      "kind": "sweeps",
      "cloudflare_account": "sweeps",
      "whm_account": "sweeps_bkp_2",
      "servers": ["bkp", "bkp-2"],
      "server_ip_env": "WHM_SWEEPS_BKP_2_SERVER_IP",
      "dns_records": [
        { "type": "A", "name": "@", "content": "{server_ip}", "proxied": true },
        { "type": "A", "name": "mail", "content": "{server_ip}", "proxied": false },
        { "type": "A", "name": "webmail", "content": "{server_ip}", "proxied": false },
        { "type": "A", "name": "www", "content": "{server_ip}", "proxied": true },
        { "type": "MX", "name": "@", "content": "mail.{domain}", "priority": 10 }
      ]
    }
  }
}
